# Copy to .env.local for development. Never commit real values.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Search engines are blocked unless the site URL is cisssolutions.co.ke or this is true
ALLOW_INDEXING=false

# --- Supabase ---------------------------------------------------------------
# Local values are printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Bypasses Row Level Security: never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- M-Pesa (Daraja) ----------------------------------------------------------
# MPESA_ENV: mock | sandbox | production
#   mock       local development; simulates STK push + callback (never allowed when NODE_ENV=production unless MPESA_ALLOW_MOCK=true)
#   sandbox    https://sandbox.safaricom.co.ke
#   production https://api.safaricom.co.ke
MPESA_ENV=mock
# Escape hatch for staging/E2E runs of a production build. Leave false on the live site.
MPESA_ALLOW_MOCK=false
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# For Till numbers the party B can differ from the shortcode; leave blank for Paybill
MPESA_PARTY_B=
# Public HTTPS URL Safaricom calls after the customer enters their PIN
MPESA_CALLBACK_URL=https://cisssolutions.co.ke/api/mpesa/callback
# Random secret appended to the callback URL so forged callbacks are rejected
MPESA_CALLBACK_SECRET=change-me-to-a-long-random-string
# Optional comma-separated source IPs allowed to call the callback (Safaricom's published list).
# Only meaningful behind a proxy that sets X-Forwarded-For reliably. Blank = no IP check.
MPESA_ALLOWED_IPS=

# --- Email --------------------------------------------------------------------
# EMAIL_PROVIDER: log (prints to server log) | resend
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM="CISS Solutions <info@cisssolutions.co.ke>"
# Comma-separated staff addresses for new-order / low-stock alerts
ADMIN_ALERT_EMAILS=

# --- Contact -------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000

# --- Scheduled jobs --------------------------------------------------------------
# Bearer token required by /api/cron/* (release expired stock reservations)
CRON_SECRET=change-me

# --- Analytics (optional; nothing loads when empty) -------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
