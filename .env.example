# Copy to .env.local for development. Never commit real values.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Search engines are blocked unless the site URL is cisssolutions.co.ke or this is true
ALLOW_INDEXING=false

# --- Supabase ---------------------------------------------------------------
# Local values are printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Bypasses Row Level Security: never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google sign-in (optional; the button is hidden when empty) -----------------
# OAuth client of type "Web application" from Google Cloud. Its authorised redirect URI
# must be <NEXT_PUBLIC_SITE_URL>/auth/google/callback, and the client ID must also be
# entered in Supabase under Authentication, Sign In / Providers, Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Proxy ---------------------------------------------------------------------
# Proxies in front of the app that add to X-Forwarded-For: 1 for Caddy alone, 2 once
# Cloudflare sits in front of Caddy. Rate limits read the visitor's address by counting
# back this many entries, so a wrong number weakens them.
TRUSTED_PROXY_HOPS=1

# --- Email --------------------------------------------------------------------
# EMAIL_PROVIDER: log (prints to server log) | smtp (send through a mailbox) | resend
EMAIL_PROVIDER=log
# smtp: the mail host's outgoing server and the mailbox that sends (usually the orders mailbox).
# Port 465 (TLS) or 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# resend: API key
EMAIL_API_KEY=
EMAIL_FROM="Ciss Solutions <orders@cisssolutions.co.ke>"
# Sender of password reset codes. Optional; this is the default.
EMAIL_FROM_NOREPLY=no-reply@cisssolutions.co.ke
# Orders mailbox: always receives new-order alerts. Send-only, replies are not read
ORDERS_EMAIL=orders@cisssolutions.co.ke
# Extra comma-separated staff addresses for new-order / low-stock alerts
ADMIN_ALERT_EMAILS=

# --- POS (optional) -------------------------------------------------------------
# Paid orders are registered as sales in the POS, a separate Supabase project, under its
# "Website" shop. URL and public (anon / publishable) key of the POS project, plus the
# secret whose hash is stored in the POS (see docs/DEPLOYMENT.md). Blank = not copied.
POS_SUPABASE_URL=
POS_SUPABASE_KEY=
POS_SYNC_SECRET=

# --- Contact -------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=254721578080

# --- Scheduled jobs --------------------------------------------------------------
# Bearer token required by /api/cron/* (release expired stock reservations)
CRON_SECRET=change-me

# --- Analytics (optional; nothing loads when empty) -------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
